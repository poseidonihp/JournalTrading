NODE_ENV=development
PORT=3000

# Postgres local (cambia 'postgres' por la password que pusiste en el instalador EDB)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/journal_dev

# Auth — generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string-at-least-32-chars
# Secreto separado para refresh tokens (opcional pero recomendado). Si se omite,
# se reutiliza JWT_SECRET. Genéralo igual que JWT_SECRET.
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

COOKIE_SECRET=replace-with-random-16-plus-chars
COOKIE_DOMAIN=
# En producción DEBE ser true (cookies sólo sobre HTTPS).
COOKIE_SECURE=false
# lax | strict | none. 'none' requiere COOKIE_SECURE=true.
COOKIE_SAMESITE=lax

# Orígenes permitidos por CORS, separados por coma (sin barra final).
CORS_ORIGINS=http://localhost:4200

# RSA keypair para cifrar el password en el cliente (defensa en profundidad sobre HTTPS).
# Genera el valor con: pnpm --filter @journal/backend gen:rsa
# La clave pública se deriva automáticamente y se expone vía GET /api/auth/public-key.
RSA_PRIVATE_KEY_B64=replace-with-base64-encoded-pkcs8-pem

# Raíz de los uploads en disco. Si se omite, usa <repo>/storage/uploads.
# En producción conviene apuntarla fuera del repo (p.ej. C:\journal-data\uploads).
STORAGE_ROOT=

# Seed (opcional, valores por defecto)
# El seed siempre siembra el catálogo de instrumentos. El usuario de desarrollo y
# los datos de ejemplo sólo se crean si SEED_DEV_USER=true — NO definirlo en
# producción, la password de abajo es conocida.
SEED_DEV_USER=true
SEED_USER_EMAIL=dev@journal.local
SEED_USER_PASSWORD=journal123
SEED_USER_NAME=Dev User
