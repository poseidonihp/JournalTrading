{
  "name": "journal",
  "version": "0.1.0",
  "private": true,
  "description": "Trading journal personal — Angular 22 + NestJS + PostgreSQL",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,js,json,md,html,css}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,html,css}\""
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "~6.0.3"
  },
  "pnpm": {
    "overrides": {
      "fastify": "^5.12.1"
    }
  }
}
