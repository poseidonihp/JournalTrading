{
  "name": "journal",
  "version": "0.1.0",
  "private": true,
  "description": "Trading journal personal — Angular 21 + NestJS + PostgreSQL",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
